#heading(level: 1)[#"數學公式"]

#"行內公式 "#mdpdf-math("E  =  m c ^(2 )")#"，以及 "#mdpdf-math("frac(a + b ,2 )")#" 與 "#mdpdf-math("mitexsqrt(x ^(2 ) +  y ^(2 ))")#"。價格 $5 到 $10 不是公式，跳脫的 $x$ 也不是。"

#"中文說明："#mdpdf-math("#textmath[速度]; =  frac(#textmath[距離];,#textmath[時間];)")#"。"

#mdpdf-math("integral _(0 )^(oo ) e ^(- x ^(2 ))thin d x  =  frac(mitexsqrt(pi ),2 )", block: true)

#mdpdf-math("sum _(i = 1 )^(n ) i  =  frac(n \\(n + 1 \\),2 )", block: true)

#mdpdf-math("aligned(\nnabla  dot.c  mitexmathbf(E ) &=  frac(rho ,epsilon _(0 )) \\ \nnabla  times  mitexmathbf(B ) &=  mu _(0 ) mitexmathbf(J )\n)", block: true)

