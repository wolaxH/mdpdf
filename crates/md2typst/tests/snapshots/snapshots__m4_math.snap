#mdpdf-math("A  =  pmatrix( 1  zws , 2  zws ; 3  zws , 4  )\\,quad \nf \\(x \\) =  cases( x ^(2 ) & quad x  >=  0  , - x  & quad x  <  0  )", block: true)

